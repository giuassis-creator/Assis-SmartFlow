# Versions
N8N_VERSION=2.37.7
POSTGRES_VERSION=16
REDIS_VERSION=7.4-alpine
QDRANT_VERSION=v1.15.1
CADDY_VERSION=2.10-alpine
WAHA_VERSION=2026.8.2
WAHA_IMAGE_TAG=gows-2026.8.2

# Public endpoint
ASSIS_DOMAIN=assis.localhost
N8N_PROTOCOL=https
N8N_HOST=${ASSIS_DOMAIN}
N8N_WEBHOOK_URL=https://${ASSIS_DOMAIN}/
# Temporary compatibility alias while local .env files are migrated.
WEBHOOK_URL=${N8N_WEBHOOK_URL}
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# Free/local AI stack
OLLAMA_VERSION=0.33.3
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_KEEP_ALIVE=10m
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_BASE_URL=http://stt:8000
KOKORO_VERSION=v0.2
TTS_BASE_URL=http://tts:7860
TTS_VOICE=pf_dora
AI_PROVIDER=ollama
AI_ALLOW_PAID_FALLBACK=false
INTERNAL_AGENT_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_TOKEN

# Identity
ORG_NAME=Minha Empresa
SECRETARY_NAME=Maya

# PostgreSQL
POSTGRES_DB=assis_smartflow
POSTGRES_USER=assis
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}

# Redis
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM

# n8n security/runtime
N8N_ENCRYPTION_KEY=CHANGE_ME_64_CHAR_RANDOM
N8N_SECURE_COOKIE=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_UNVERIFIED_PACKAGES_ENABLED=false
N8N_RUNNERS_TASK_TIMEOUT=300
# Assis workflows must not read process environment variables from Code/Expression nodes.
# Provider secrets are validated by scoped hashes/credentials instead.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# WhatsApp provider routing
# WAHA Community is the default free/self-hosted provider. Evolution remains optional/legacy.
WHATSAPP_PROVIDER_DEFAULT=waha

# WAHA Community
# For GOWS on amd64, Docker Hub publishes gows-<version> (for example gows-2026.8.2), not the bare version tag.
# ARM deployments should use gows-arm-<version>.
WAHA_API_KEY=CHANGE_ME_LONG_RANDOM_WAHA_API_KEY
WAHA_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_WAHA_WEBHOOK_SECRET
WAHA_ENGINE=GOWS
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_LONG_RANDOM_WAHA_DASHBOARD_PASSWORD
WAHA_SWAGGER_ENABLED=false
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=false
WAHA_WEBHOOK_RETRIES=4
# Logical session and organization used for the initial tenant. Additional organizations get distinct session mappings in PostgreSQL.
WAHA_SESSION=default
WAHA_ORGANIZATION_SLUG=default
# Optional real-number smoke target. Leave empty to prevent any automatic WhatsApp send during deployment.
WAHA_TEST_NUMBER=

# Evolution legacy compatibility
EVOLUTION_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_EVOLUTION_SECRET
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_SENDTEXT_PAYLOAD_STYLE=modern
EVOLUTION_TEST_NUMBER=

# Chatwoot should use the same scoped-hash pattern when its adapter is deployed.
CHATWOOT_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_CHATWOOT_SECRET

# Optional object storage / providers
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CHATWOOT_BASE_URL=
ASAAS_BASE_URL=https://api.asaas.com

# LLM/RAG credentials belong in n8n credential store; do not commit here.
