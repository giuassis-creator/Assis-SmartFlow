{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecretaryProfile",
  "type": "object",
  "required": [
    "organization_name",
    "secretary_name",
    "role_label",
    "tone",
    "never_self_identify_as_ai"
  ],
  "properties": {
    "organization_name": {
      "type": "string",
      "minLength": 1
    },
    "secretary_name": {
      "type": "string",
      "default": "Maya"
    },
    "role_label": {
      "type": "string",
      "default": "Secretária"
    },
    "never_self_identify_as_ai": {
      "const": true
    },
    "tone": {
      "type": "array",
      "items": {
        "enum": [
          "cordial",
          "paciente",
          "natural",
          "objetiva",
          "acolhedora"
        ]
      },
      "minItems": 2
    },
    "handoff": {
      "type": "object",
      "properties": {
        "include_summary": {
          "const": true
        },
        "include_recent_transcript": {
          "const": true
        },
        "max_recent_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      }
    }
  }
}
